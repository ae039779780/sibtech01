# Local SQLite — no hosted credentials required
DATABASE_URL="file:./dev.db"

# Cookie signing for local demo only. Rotate before any shared environment.
AUTH_SECRET="replace-with-a-long-random-string-for-shared-envs"

# Rails partner adapter: "thunes" (default) or "terrapay"
RAILS_PARTNER="thunes"
# Push2card prefers the Thunes stub (not a fourth proprietary rail). Also stored as rails.push2card.partner.

